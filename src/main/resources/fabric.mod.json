{
	"schemaVersion": 1,
	"id": "turbomc",
	"version": "${version}",
	"name": "TurboMC",
	"description": "在 Minecraft 里运行 Scratch 积木脚本。脚本用 TurboWarp 编写并导出为 .sb3，模组负责加载与执行。",
	"authors": [
		"TurboMC"
	],
	"contact": {},
	"license": "MIT",
	"icon": "assets/turbomc/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"xyz.turbomc.TurboMC"
		],
		"client": [
			"xyz.turbomc.client.TurboMCClient"
		],
		"modmenu": [
			"xyz.turbomc.client.config.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "turbomc.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"recommends": {
		"modmenu": ">=17.0.1",
		"cloth-config": ">=21.11.153"
	}
}