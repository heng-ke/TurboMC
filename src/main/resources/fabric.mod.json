{
	"schemaVersion": 1,
	"id": "hk-script",
	"version": "${version}",
	"name": "hk-script",
	"description": "在 Minecraft 里运行 Scratch 积木脚本。脚本用 TurboWarp 编写并导出为 .sb3，模组负责加载与执行。",
	"authors": [
		"hk-script"
	],
	"contact": {},
	"license": "CC0-1.0",
	"icon": "assets/hk-script/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"xyz.hegke.HkScript"
		],
		"client": [
			"xyz.hegke.client.HkScriptClient"
		],
		"modmenu": [
			"xyz.hegke.client.config.ModMenuIntegration"
		]
	},
	"mixins": [
		"hk-script.mixins.json",
		{
			"config": "hk-script.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"recommends": {
		"modmenu": ">=17.0.1",
		"cloth-config": ">=21.11.153"
	}
}