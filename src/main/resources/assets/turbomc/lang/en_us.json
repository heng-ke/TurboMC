{
  "config.turbomc.title": "TurboMC",
  "config.turbomc.category.general": "General",
  "config.turbomc.category.keys": "Key permissions",
  "config.turbomc.keys.intro": "Before pressing a key the script checks the block list, then the allow list. Empty allow list = no restriction.",
  "config.turbomc.blocked_keys": "Block list (never press)",
  "config.turbomc.blocked_keys.tooltip": "Empty = block nothing. Default blocks keys that steal keyboard focus: chat, command, screenshot, fullscreen, pause, advancements, social.",
  "config.turbomc.allowed_keys": "Allow list (only these)",
  "config.turbomc.allowed_keys.tooltip": "Empty = no restriction. When filled, only the listed keys can be pressed by scripts.",
  "config.turbomc.key_help": "Key name reference (click to expand)",
  "config.turbomc.key_help.letters": "Letters and digits: a b c ... z   0 1 ... 9",
  "config.turbomc.key_help.function": "Function keys: f1 to f12",
  "config.turbomc.key_help.common": "Common: space enter tab backspace escape slash period comma semicolon minus equal",
  "config.turbomc.key_help.arrows": "Arrows: up down left right",
  "config.turbomc.key_help.modifiers": "Modifiers: left shift / right shift / left control / left alt (short forms: shift ctrl alt esc)",
  "config.turbomc.key_help.action": "Action ids: key.chat, key.screenshot. Names starting with key. match by action, unaffected by rebinding.",
  "config.turbomc.category.script": "Script engine",
  "config.turbomc.master_enabled": "Master Switch",
  "config.turbomc.master_enabled.tooltip": "Turns all client-side automation features on or off at once.",
  "config.turbomc.hud_offset_x": "HUD Horizontal Position (%)",
  "config.turbomc.hud_offset_x.tooltip": "0% hugs the left edge, 100% the right, 50% centers. The panel always grows right and down, so its right edge stays put when content gets wider.",
  "config.turbomc.hud_offset_y": "HUD Vertical Position (%)",
  "config.turbomc.hud_offset_y.tooltip": "0% hugs the top, 100% the bottom. A bottom-anchored panel grows upward as rows are added; overlapping the hotbar, health bar or chat is up to you.",
  "config.turbomc.auto_respawn": "Auto respawn on death",
  "config.turbomc.auto_respawn.tooltip": "Respawn automatically when the death screen appears, no script needed. Sends one request only; does not return you to where you died.",
  "config.turbomc.disable_on_exit": "Turn engine off when leaving a world",
  "config.turbomc.disable_on_exit.tooltip": "When on, leaving a save or disconnecting from a server switches the master switch off, so the next world needs F6 again. When off, the previous state is remembered and scripts start as soon as you join.",
  "config.turbomc.show_path": "Show path when walking",
  "config.turbomc.show_path.tooltip": "Draws the A* route while the go-to block runs: cyan polyline, white current node, yellow end. Stays 3 seconds after finishing.",
  "config.turbomc.show_path_hud": "Show path state on HUD",
  "config.turbomc.show_path_hud.tooltip": "While walking, show target coordinates, remaining distance, node progress and planning time on the HUD. Stays 3 seconds after finishing.",
  "config.turbomc.category.pathing": "Pathfinding",
  "config.turbomc.pathing.hint": "These control how precisely the \"go to\" block lands and how much A* search it may spend. Changes apply on the next tick - no world reload needed. Defaults are exactly the values that used to be hardcoded.",
  "config.turbomc.pathing.arrive_horizontal": "Horizontal arrival radius (blocks)",
  "config.turbomc.pathing.arrive_horizontal.tooltip": "Arrives once the horizontal distance to the target block centre drops below this (0.30-1.20, default 0.6). Larger stops earlier; too small and the player may hover around the target forever.",
  "config.turbomc.pathing.arrive_vertical": "Vertical arrival tolerance (blocks)",
  "config.turbomc.pathing.arrive_vertical.tooltip": "Vertical tolerance (0.50-0.90, default 0.6). 0.6 fits a slab's 0.5 but not a full block; 0.9 would count \"standing one block below the target\" as arrived.",
  "config.turbomc.pathing.node_reach": "Node advance threshold (blocks)",
  "config.turbomc.pathing.node_reach.tooltip": "How close to the current path node before switching to the next (0.35-0.60, default 0.5). Larger reacts sooner but cuts corners and scrapes walls; smaller oscillates at corners. It interacts with the stand-turn threshold - tune them as a pair.",
  "config.turbomc.pathing.accuracy": "A* arrival tolerance (blocks)",
  "config.turbomc.pathing.accuracy.tooltip": "Only decides where A* stops: 0 = must be the target block itself; 1 = any block adjacent to the target (default); 2 = may stop two blocks away, which conflicts with \"go to exact coordinates\". It does not change search volume or performance.",
  "config.turbomc.pathing.stand_turn_deg": "Stand-and-turn threshold (degrees)",
  "config.turbomc.pathing.stand_turn_deg.tooltip": "Above this heading error the player stops before turning, otherwise turns while walking (20-60, default 30). Raising it hands more angles to \"turn while walking\", whose turning radius is about 1.03 blocks - targets within a block can end up in circles.",
  "config.turbomc.pathing.effort": "Search effort",
  "config.turbomc.pathing.effort.tooltip": "How many A* nodes may be expanded, scaled by target distance (8 / 14 / 22 per block). Light saves frame time but detours often yield only a partial path; Heavy solves complex terrain in one pass at the cost of per-frame planning time.",
  "config.turbomc.pathing.effort.light": "Light",
  "config.turbomc.pathing.effort.normal": "Normal",
  "config.turbomc.pathing.effort.heavy": "Heavy",
  "config.turbomc.pathing.max_distance": "Maximum target distance (blocks)",
  "config.turbomc.pathing.max_distance.tooltip": "Give up beyond this distance (32-192, default 128). The session timeout scales with it, so distant targets are not cut short; but past roughly 67 blocks the span cap kicks in and the walk becomes segment-by-segment, raising time and stutter.",
  "config.turbomc.monitor_list_items": "HUD list monitor items",
  "config.turbomc.monitor_list_items.tooltip": "How many items of a shown list are listed on the HUD; the rest is summarized by count.",
  "config.turbomc.chat_interval": "Chat segment interval (ticks)",
  "config.turbomc.chat_interval.tooltip": "Long replies are split into segments and sent one by one; this is the gap between them. Default 3 is about 150 ms. Do not use 1: vanilla caps chat at 20 messages per second and one per tick trips the spam check.",
  "config.turbomc.chat_max_segments": "Max segments per message",
  "config.turbomc.chat_max_segments.tooltip": "Each segment is capped at 256 characters (768 bytes). 8 segments is about 2000 characters; the rest is dropped and the last segment ends with an ellipsis.",
  "config.turbomc.chat_server_messages": "Treat server messages as chat",
  "config.turbomc.chat_server_messages.tooltip": "Proxy servers deliver player chat as server (system) messages. Without this, \"when chat contains\" never fires on those servers. Turning it off restores 1.3.0 behaviour: only real player chat triggers.",
  "config.turbomc.chat_server_any_match": "Server messages also trigger hats without a keyword",
  "config.turbomc.chat_server_any_match.tooltip": "When off, only hats whose keyword is known and matched fire on server messages; empty keywords and compound expressions do not. When on, it degrades to match-anything and plugin ads will start your scripts. A variable plugged straight into the keyword slot is evaluated normally and is unaffected by this option.",
  "config.turbomc.category.ai": "AI chat",
  "config.turbomc.ai.hint": "Uses the OpenAI-compatible format (/v1/chat/completions). The API key is stored in plain text in config/turbomc.json — do not share that file.",
  "config.turbomc.ai.base_url": "Endpoint",
  "config.turbomc.ai.base_url.tooltip": "Without /chat/completions, e.g. https://api.deepseek.com/v1. For local models use http://127.0.0.1:11434/v1.",
  "config.turbomc.ai.api_key": "API key",
  "config.turbomc.ai.api_key.tooltip": "Stored as plain text in config/turbomc.json. The saved value is never shown here; type a new one to replace it, or - to clear. Leave empty for local models that do not check it.",
  "config.turbomc.ai.api_key.hint": "The saved key is never shown. Type a new value to replace it, or - to clear.",
  "config.turbomc.ai.model": "Model",
  "config.turbomc.ai.model.tooltip": "e.g. deepseek-chat, qwen-plus, gpt-4o-mini. Both endpoint and model must be set.",
  "config.turbomc.ai.temperature": "Temperature",
  "config.turbomc.ai.temperature.tooltip": "Between 0 and 2. Lower is more deterministic. Invalid input keeps the previous value.",
  "config.turbomc.ai.max_tokens": "Max reply tokens",
  "config.turbomc.ai.max_tokens.tooltip": "The HUD bubble is a single line — 200-400 is a good range, and ask for short answers in the system prompt.",
  "config.turbomc.ai.timeout": "Timeout (seconds)",
  "config.turbomc.ai.timeout.tooltip": "Past this the request fails and the block returns an empty string. The script-side wait limit is 2 seconds longer.",
  "config.turbomc.ai.history_turns": "History turns",
  "config.turbomc.ai.history_turns.tooltip": "One question plus one answer counts as a turn. 0 means no history.",
  "config.turbomc.ai.max_concurrent": "Max concurrent requests",
  "config.turbomc.ai.max_concurrent.tooltip": "Upper bound on in-flight requests, so a bad script cannot flood the API or the bill.",
  "config.turbomc.ai.hud_hold_seconds": "HUD verdict hold (seconds)",
  "config.turbomc.ai.hud_hold_seconds.tooltip": "How long a success or failure verdict stays on the HUD. Waiting state is unaffected and stays until it resolves.",
  "config.turbomc.ai.hud_max_rows": "Max sessions shown on HUD",
  "config.turbomc.ai.hud_max_rows.tooltip": "Sessions are sorted by name and the first few are shown, so the HUD is not taken over by AI status.",
  "config.turbomc.ai.hud_reply_chars": "HUD reply preview length",
  "config.turbomc.ai.hud_reply_chars.tooltip": "A full reply does not fit on one HUD line, so only the beginning is shown. Open F7 > Runtime for the full text.",
  "config.turbomc.missing_cloth_config.title": "Configuration Unavailable",
